{
  "name": "personal-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 VuePress 2 的个人知识库静态网站",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "content:check": "node scripts/check-content.mjs",
    "docs:dev": "vuepress dev docs",
    "docs:clean-dev": "vuepress dev docs --clean-cache",
    "docs:build": "pnpm content:check && vuepress build docs && node scripts/postbuild.mjs"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-medium-zoom": "2.0.0-rc.131",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.131",
    "@vuepress/theme-default": "2.0.0-rc.132",
    "gray-matter": "^4.0.3",
    "sass": "^1.101.0",
    "vue": "^3.5.18",
    "vue-router": "5.2.0",
    "vuepress": "2.0.0-rc.30"
  }
}
